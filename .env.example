# Copy to web/.env.local and fill in from Supabase → Project Settings → API.
#
# Both of these are safe in a browser. The anon (publishable) key grants only
# what row level security allows, and every policy requires a signed-in session.
#
# The service role (secret) key does NOT go here. It bypasses RLS entirely and
# belongs in GitHub Actions secrets, for the solver worker. See docs/SETUP.md.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
